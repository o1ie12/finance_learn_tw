# Copy this file to .env.local and fill in real values.
# .env.local is gitignored — never commit real keys.

# --- Supabase (server-side only) ---
# Project settings → API. The SERVICE ROLE key is secret; never ship it to the client.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- AI coach (server-side only) ---
# The flagship 起薪線 coach can use Anthropic Claude Haiku directly.
ANTHROPIC_API_KEY=

# OpenRouter (planned, Section 9) — model routing for the cross-line AI coach,
# so the model can be swapped via env without a code change. Not wired yet;
# with no key the coach shows a graceful "not configured" state in production.
# Use an OpenAI-compatible client with base URL https://openrouter.ai/api/v1.
OPENROUTER_API_KEY=
# Configurable model id (free-tier :free models rotate — don't hardcode one).
OPENROUTER_MODEL=

# --- Optional ---
# Public site URL, used for metadata/OG tags. Defaults to http://localhost:3000
# NEXT_PUBLIC_SITE_URL=https://your-app.vercel.app

# Local-dev testing aid ONLY. When Supabase/Anthropic are not configured and
# NODE_ENV !== production, set USE_DEV_STORE=1 to run the full flow against a
# gitignored .devstore.json file plus a grounded coach stub. Never set in prod.
# USE_DEV_STORE=1

# --- TEMPORARY: dashboard map-vs-card-grid pilot test ---
# See app/dashboard-preview, components/DashboardABTest.tsx, and lib/config.ts.
# Gates a standalone /dashboard-preview page (sample data only — no signup, no
# database) comparing the live transit-map dashboard against a card-grid
# alternative, shared directly with the pilot group. Set to "true" to turn it
# on; delete this flag (and the code it gates) once the pilot's feedback picks
# a winner.
# ENABLE_DASHBOARD_AB_TEST=true

# Google Form URL for the pilot's feedback CTA ("告訴我們你的想法"). The form
# itself is created separately (not by this codebase). Leave unset to hide the
# CTA link instead of pointing it nowhere.
# AB_TEST_FEEDBACK_FORM_URL=
