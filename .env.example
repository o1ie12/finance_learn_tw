# Copy this file to .env.local and fill in real values.
# .env.local is gitignored — never commit real keys.

# --- Supabase (server-side only) ---
# Project settings → API. The SERVICE ROLE key is secret; never ship it to the client.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# The ANON key (same page). Safe to expose to a browser in general, but this
# app only uses it server-side to run the Google OAuth handshake (lib/supabaseAuth.ts).
SUPABASE_ANON_KEY=

# --- Google Sign-in (optional, additive — see supabase/migration-02-google-auth.sql) ---
# The Google OAuth client id/secret are NOT read by this app directly. Create
# them in Google Cloud Console (OAuth client, scopes: profile + email only —
# no Calendar/Gmail/Drive), then paste them into the Supabase dashboard under
# Authentication → Providers → Google. Supabase holds them and performs the
# token exchange server-to-server; this app never sees them.
#   Google Cloud Console client id:     (configured in Supabase, not here)
#   Google Cloud Console client secret: (configured in Supabase, not here)
#
# Restrict Google sign-in to one email domain (e.g. a partner school), or
# leave empty to allow any Google account — the default, since no partner
# school domain is confirmed yet. Enforced server-side in every case, not
# just as the `hd` UI hint sent to Google's account chooser.
ALLOWED_GOOGLE_DOMAIN=

# --- AI coach (server-side only) ---
# The flagship 起薪線 coach can use Anthropic Claude Haiku directly.
ANTHROPIC_API_KEY=

# OpenRouter — powers the AI coach for 存錢線/信用線/投資線 (起薪線 uses
# ANTHROPIC_API_KEY above directly). Both OPENROUTER_API_KEY and
# OPENROUTER_MODEL are required together; with either missing, those three
# lines' coach shows a grounded dev stub locally or a graceful "not
# configured" state in production — same as qixin without a key.
OPENROUTER_API_KEY=
# Model id, e.g. "anthropic/claude-haiku-4.5" or a free-tier ":free" model.
# Free-tier models rotate/deprecate — don't assume a placeholder here still
# exists; check https://openrouter.ai/models before setting this.
OPENROUTER_MODEL=

# --- Optional ---
# Public site URL, used for metadata/OG tags. Defaults to http://localhost:3000
# NEXT_PUBLIC_SITE_URL=https://your-app.vercel.app

# Local-dev testing aid ONLY. When Supabase/Anthropic are not configured and
# NODE_ENV !== production, set USE_DEV_STORE=1 to run the full flow against a
# gitignored .devstore.json file plus a grounded coach stub. Never set in prod.
# USE_DEV_STORE=1
